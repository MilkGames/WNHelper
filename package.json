{
    "name": "discord-bot-wn-helper",
    "version": "2.0",
    "main": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "test": "node --test tests/*.test.js tests/characterization/*.test.js",
        "test:syntax": "node -e \"const fs=require('fs'),path=require('path'),cp=require('child_process');function walk(d){return fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(d,e.name)):e.name.endsWith('.js')?[path.join(d,e.name)]:[])}for(const f of [...walk('src'),...walk('tests')])cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'});\"",
        "check": "npm test && npm run test:syntax"
    },
    "keywords": [],
    "author": "",
    "license": "GPL-3.0-or-later",
    "description": "Discord bot for Majestic RP Weazel News Discord servers.",
    "dependencies": {
        "discord.js": "^14.15.3",
        "dotenv": "^16.4.5",
        "express": "^4.21.2"
    },
    "engines": {
        "node": ">=20"
    }
}
